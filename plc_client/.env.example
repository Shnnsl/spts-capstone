SPTS_API_BASE_URL=http://192.168.1.22:8000
SPTS_USERNAME=replace_with_line_workstation_username
SPTS_PASSWORD=replace_with_password
SPTS_LINE_ID=LINE-01
GPIO_MODE=mock
LOG_LEVEL=INFO
LOG_PATH=logs/spts-plc-client.log
HTTP_TIMEOUT=10
HTTP_RETRIES=3
QUEUE_PATH=data/event_queue.sqlite3
DEBOUNCE=0.08
SPTS_TERMINAL_STATUS_ENABLED=true
SPTS_TERMINAL_STATUS_FORCE=false
SPTS_TERMINAL_STATUS_INTERVAL_SECONDS=2
SPTS_HEARTBEAT_ENABLED=false
SPTS_HEARTBEAT_INTERVAL_SECONDS=30
SPTS_CLIENT_VERSION=1.0.0
